{
  "version": 6,
  "configurePresets": [
    {
      "name": "windows-release",
      "displayName": "Windows Release",
      "binaryDir": "${sourceDir}/build-msvc-preset-release",
      "cacheVariables": {
        "BUILD_PYTHON": "ON",
        "BUILD_FFI": "ON",
        "BUILD_TESTS": "ON",
        "BUILD_BENCHMARKS": "OFF"
      }
    },
    {
      "name": "windows-debug",
      "displayName": "Windows Debug",
      "inherits": "windows-release",
      "binaryDir": "${sourceDir}/build-msvc-preset-debug"
    },
    {
      "name": "ffi-only",
      "displayName": "Windows FFI Only",
      "inherits": "windows-release",
      "binaryDir": "${sourceDir}/build-msvc-preset-ffi",
      "cacheVariables": {
        "BUILD_PYTHON": "OFF",
        "BUILD_FFI": "ON",
        "BUILD_TESTS": "OFF",
        "BUILD_ANALYSIS_TESTS": "OFF"
      }
    },
    {
      "name": "no-python-no-tests",
      "displayName": "Windows Minimal App Native",
      "inherits": "windows-release",
      "binaryDir": "${sourceDir}/build-msvc-preset-minimal",
      "cacheVariables": {
        "BUILD_PYTHON": "OFF",
        "BUILD_FFI": "OFF",
        "BUILD_TESTS": "OFF",
        "BUILD_ANALYSIS_TESTS": "OFF",
        "BUILD_BENCHMARKS": "OFF"
      }
    },
    {
      "name": "macos-release",
      "displayName": "macOS Release Native",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build-macos-preset-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "BUILD_ANALYSIS": "OFF",
        "BUILD_PYTHON": "OFF",
        "BUILD_FFI": "OFF",
        "BUILD_TESTS": "ON",
        "BUILD_BENCHMARKS": "OFF"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      }
    },
    {
      "name": "macos-asan",
      "displayName": "macOS AddressSanitizer Native",
      "inherits": "macos-release",
      "binaryDir": "${sourceDir}/build-macos-preset-asan",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "VOID_SANITIZER": "address"
      }
    },
    {
      "name": "macos-werror",
      "displayName": "macOS Warnings-as-Errors Native",
      "inherits": "macos-release",
      "binaryDir": "${sourceDir}/build-macos-preset-werror",
      "cacheVariables": {
        "VOID_ENABLE_WARNINGS_AS_ERRORS": "ON"
      }
    },
    {
      "name": "macos-tsan",
      "displayName": "macOS ThreadSanitizer Native",
      "inherits": "macos-release",
      "binaryDir": "${sourceDir}/build-macos-preset-tsan",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "VOID_SANITIZER": "thread"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "windows-release",
      "configurePreset": "windows-release",
      "configuration": "Release"
    },
    {
      "name": "windows-debug",
      "configurePreset": "windows-debug",
      "configuration": "Debug"
    },
    {
      "name": "ffi-only-release",
      "configurePreset": "ffi-only",
      "configuration": "Release"
    },
    {
      "name": "minimal-release",
      "configurePreset": "no-python-no-tests",
      "configuration": "Release"
    },
    {
      "name": "macos-release",
      "configurePreset": "macos-release"
    },
    {
      "name": "macos-asan",
      "configurePreset": "macos-asan"
    },
    {
      "name": "macos-werror",
      "configurePreset": "macos-werror"
    },
    {
      "name": "macos-tsan",
      "configurePreset": "macos-tsan"
    }
  ],
  "testPresets": [
    {
      "name": "windows-release",
      "configurePreset": "windows-release",
      "configuration": "Release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "windows-debug",
      "configurePreset": "windows-debug",
      "configuration": "Debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "macos-release",
      "configurePreset": "macos-release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "macos-asan",
      "configurePreset": "macos-asan",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "macos-werror",
      "configurePreset": "macos-werror",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "macos-tsan",
      "configurePreset": "macos-tsan",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
